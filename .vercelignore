# Files never uploaded to Vercel, including by `vercel deploy` from this machine

# The recorder only runs locally (npm run record); the deployment ships the
# demo recordings in public/recordings/ instead
scripts
/recordings

# Local secrets. The deployment never contacts OpenSky; VITE_MAPBOX_TOKEN comes
# from the Vercel project's environment variables, not an uploaded .env file
.env
.env.*

node_modules
dist
